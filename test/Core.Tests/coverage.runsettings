<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage settings for the XPlat Code Coverage collector, locally and in CI. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Source generators (e.g. [GeneratedRegex]) write their code under obj/ and mark it
               [GeneratedCode]; it is not ours to cover, and the CI coverage report cannot read it. -->
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
