<ui:FluentWindow
    x:Class="CredBench.Windows.Views.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:CredBench.Windows.Views"
    xmlns:controls="clr-namespace:ZBitSystems.Wpf.UI.Controls;assembly=ZBitSystems.Wpf.UI"
    xmlns:localization="clr-namespace:ZBitSystems.Wpf.UI.Localization;assembly=ZBitSystems.Wpf.UI"
    mc:Ignorable="d"
    Title="{localization:Localize About_Title}"
    AutomationProperties.AutomationId="AboutWindow"
    Width="640"
    Height="600"
    MinWidth="480"
    MinHeight="400"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True"
    d:DataContext="{d:DesignInstance views:AboutWindow, IsDesignTimeCreatable=False}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{localization:Localize About_Title}" ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/CredBench;component/Assets/Logo.png"
                    RenderOptions.BitmapScalingMode="HighQuality" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{localization:Localize About_ApplicationName}" Style="{StaticResource Text.Title}" />
                        <TextBlock Text="{Binding AppVersion}"
                            AutomationProperties.AutomationId="AboutVersionText"
                            Style="{StaticResource Text.Subtitle}" />
                        <TextBlock Text="{Binding Copyright}"
                            AutomationProperties.AutomationId="AboutCopyrightText"
                            Style="{StaticResource Text.Body}" />
                        <TextBlock Text="{localization:Localize About_Description}"
                            Style="{StaticResource Text.Body}"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Margin="0,12,0,0" />
                    </StackPanel>

                    <Image Grid.Column="1"
                        Source="/CredBench;component/Assets/Logo.png"
                        Width="140"
                        Height="140"
                        Margin="16,0,0,0"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        AutomationProperties.Name="{localization:Localize About_Logo}" />
                </Grid>

                <TextBlock Text="{localization:Localize About_LicenseInfo}"
                    Style="{StaticResource Text.Headline}"
                    HorizontalAlignment="Center"
                    Margin="0,24,0,10" />
                <controls:LicenseExpander Header="{localization:Localize About_ApacheLicense}"
                    MaxContentHeight="300"
                    ResourceUri="pack://application:,,,/CredBench;component/Assets/Apache.txt" />
                <controls:LicenseExpander Header="{localization:Localize About_MITLicense}"
                    MaxContentHeight="300"
                    Margin="0,10,0,0"
                    ResourceUri="pack://application:,,,/CredBench;component/Assets/MIT.txt" />
                <controls:LicenseExpander Header="{localization:Localize About_BSDLicense}"
                    MaxContentHeight="300"
                    Margin="0,10,0,0"
                    ResourceUri="pack://application:,,,/CredBench;component/Assets/BSD.txt" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
            Padding="24,12"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <ui:Button
                Content="{localization:Localize About_Close}"
                Click="Close_Click"
                IsCancel="True"
                AutomationProperties.AutomationId="AboutCloseButton"
                Appearance="Secondary"
                HorizontalAlignment="Right"
                MinWidth="100" />
        </Border>
    </Grid>
</ui:FluentWindow>
