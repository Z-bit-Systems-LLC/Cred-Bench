<ui:FluentWindow
    x:Class="CredBench.Windows.Views.ProgramCardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:viewmodels="clr-namespace:CredBench.Core.ViewModels;assembly=Core"
    xmlns:guidelinesConverters="clr-namespace:ZBitSystems.Wpf.UI.Converters;assembly=ZBitSystems.Wpf.UI"
    xmlns:localization="clr-namespace:ZBitSystems.Wpf.UI.Localization;assembly=ZBitSystems.Wpf.UI"
    mc:Ignorable="d"
    Title="{localization:Localize Prog_Title}"
    Width="600"
    Height="760"
    MinWidth="480"
    MinHeight="400"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True"
    d:DataContext="{d:DesignInstance viewmodels:ProgramCardViewModel}">

    <ui:FluentWindow.Resources>
        <guidelinesConverters:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <guidelinesConverters:NullToVisibilityConverter x:Key="NullToVisibility" />

        <!-- Inputs are locked while the card is being written -->
        <Style x:Key="LockedWhileProgramming" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsProgramming}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{localization:Localize Prog_Title}" ShowMaximize="False" ShowMinimize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,16">
                <TextBlock Text="{localization:Localize Prog_Intro}"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,16" />

                <!-- ═══════════ Card content (GP GET STATUS), queried when the dialog opens ═══════════ -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{localization:Localize PKOC_CardInfo_Header}"
                        Style="{StaticResource Section.Header}" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="1"
                        Content="{localization:Localize PKOC_CardInfo_RefreshButton}"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        Command="{Binding QueryCardContentCommand}"
                        Appearance="Secondary" />
                </Grid>

                <StackPanel Margin="0,0,0,16">
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8"
                        Visibility="{Binding IsQuerying, Converter={StaticResource BoolToVisibility}}" />

                    <Border Margin="0,0,0,8" Padding="10,8"
                        CornerRadius="{StaticResource CornerRadius.Small}"
                        Background="{StaticResource Brush.Error}"
                        Visibility="{Binding QueryError, Converter={StaticResource NullToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding QueryError}" Foreground="White" TextWrapping="Wrap" />
                            <StackPanel Visibility="{Binding QueryErrorDetails, Converter={StaticResource NullToVisibility}}">
                                <ui:Button Command="{Binding ToggleQueryErrorDetailsCommand}"
                                    Margin="0,6,0,0" Appearance="Secondary" Padding="8,2">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Content" Value="{localization:Localize PKOC_CardInfo_ShowDetails}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowQueryErrorDetails}" Value="True">
                                                    <Setter Property="Content" Value="{localization:Localize PKOC_CardInfo_HideDetails}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                                <TextBox Text="{Binding QueryErrorDetails, Mode=OneWay}" IsReadOnly="True"
                                    TextWrapping="Wrap" FontFamily="Consolas"
                                    FontSize="{StaticResource FontSize.Caption}" Margin="0,4,0,0"
                                    Visibility="{Binding ShowQueryErrorDetails, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <ui:Button Content="{localization:Localize PKOC_Programming_Dismiss}"
                                Command="{Binding DismissQueryErrorCommand}"
                                Margin="0,6,0,0" Appearance="Secondary" />
                        </StackPanel>
                    </Border>

                    <StackPanel Visibility="{Binding HasCardContent, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                            Visibility="{Binding CardContent.FreePersistentMemory, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{localization:Localize PKOC_CardInfo_FreeMemory}"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Margin="4,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding CardContent.FreePersistentMemory, StringFormat='{}{0:N0} bytes'}" />
                        </StackPanel>

                        <Border Margin="0,4,0,0" Padding="8,6" CornerRadius="{StaticResource CornerRadius.Small}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CardContent.HasPkocApplet}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{localization:Localize PKOC_CardInfo_PkocNotInstalled}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CardContent.HasPkocApplet}" Value="True">
                                                <Setter Property="Text" Value="{localization:Localize PKOC_CardInfo_PkocInstalled}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="FontWeight" Value="Medium" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <Border Margin="0,4,0,0" Padding="8,6" CornerRadius="{StaticResource CornerRadius.Small}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CardContent.HasLeafApplet}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{localization:Localize Prog_CardInfo_LeafNotInstalled}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CardContent.HasLeafApplet}" Value="True">
                                                <Setter Property="Text" Value="{localization:Localize Prog_CardInfo_LeafInstalled}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="FontWeight" Value="Medium" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{localization:Localize PKOC_CardInfo_Applets}"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    FontSize="{StaticResource FontSize.Caption}" Margin="0,0,0,2" />
                                <ItemsControl ItemsSource="{Binding CardContent.Applets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <TextBlock Text="{Binding AidHex}" FontFamily="Consolas"
                                                FontSize="{StaticResource FontSize.Caption}"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text=" — " FontSize="{StaticResource FontSize.Caption}"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{Binding LifecycleDescription}"
                                                FontSize="{StaticResource FontSize.Caption}"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{localization:Localize PKOC_CardInfo_Packages}"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    FontSize="{StaticResource FontSize.Caption}" Margin="0,0,0,2" />
                                <ItemsControl ItemsSource="{Binding CardContent.Packages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <TextBlock Text="{Binding AidHex}" FontFamily="Consolas"
                                                FontSize="{StaticResource FontSize.Caption}"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            <TextBlock Text=" — " FontSize="{StaticResource FontSize.Caption}"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                            <TextBlock Text="{Binding LifecycleDescription}"
                                                FontSize="{StaticResource FontSize.Caption}"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <StackPanel Style="{StaticResource LockedWhileProgramming}">

                    <!-- ═══════════ PKOC ═══════════ -->
                    <CheckBox IsChecked="{Binding ProgramPkoc}" FontWeight="SemiBold"
                        Content="{localization:Localize Prog_Pkoc}" />
                    <TextBlock Text="{localization:Localize Prog_Pkoc_Hint}"
                        TextWrapping="Wrap"
                        Margin="28,0,0,16"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <!-- ═══════════ LEAF Verified ═══════════ -->
                    <CheckBox IsChecked="{Binding ProgramLeaf}" FontWeight="SemiBold"
                        Content="{localization:Localize Prog_Leaf}" />
                    <TextBlock Text="{localization:Localize Prog_Leaf_Hint}"
                        TextWrapping="Wrap"
                        Margin="28,0,0,8"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Border Margin="28,0,0,12" Padding="12,8"
                        CornerRadius="{StaticResource CornerRadius.Small}"
                        Background="{StaticResource Brush.Warning}"
                        Visibility="{Binding ProgramLeaf, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Warning24" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Top" />
                            <TextBlock Text="{localization:Localize Prog_Leaf_TestOnly}"
                                Foreground="White" FontWeight="Medium" TextWrapping="Wrap" MaxWidth="460" />
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="28,0,0,0"
                        Visibility="{Binding ProgramLeaf, Converter={StaticResource BoolToVisibility}}">
                        <!-- Test root -->
                        <TextBlock Text="{localization:Localize LEAFV_Prog_TestRoot}"
                            Style="{StaticResource Field.Label}"
                            FontSize="{StaticResource FontSize.Caption}" />
                        <TextBlock Text="{Binding TestCaName}" FontWeight="Medium"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Visibility="{Binding HasTestCa, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding TestCaDirectory}" FontSize="{StaticResource FontSize.Caption}"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Visibility="{Binding HasTestCa, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{localization:Localize LEAFV_Prog_NoTestRoot}"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Visibility="{Binding HasTestCa, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                        <WrapPanel Margin="0,8,0,0">
                            <ui:Button
                                Content="{localization:Localize LEAFV_Prog_LoadTestRoot}"
                                Icon="{ui:SymbolIcon FolderOpen24}"
                                Click="LoadTestCa_Click"
                                Appearance="Secondary"
                                Margin="0,0,8,0" />
                            <ui:Button
                                Content="{localization:Localize LEAFV_Prog_CreateTestRoot}"
                                Icon="{ui:SymbolIcon Add24}"
                                Click="CreateTestCa_Click"
                                Appearance="Secondary" />
                        </WrapPanel>
                        <TextBlock
                            Text="{Binding TestCaMessage}"
                            Margin="0,8,0,0"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Visibility="{Binding TestCaMessage, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Text="{localization:Localize LEAFV_Prog_TestRootHint}"
                            TextWrapping="Wrap"
                            FontSize="{StaticResource FontSize.Caption}"
                            Margin="0,4,0,12"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                        <!-- Open ID -->
                        <TextBlock Text="{localization:Localize LEAFV_Prog_OpenId}"
                            Style="{StaticResource Field.Label}"
                            FontSize="{StaticResource FontSize.Caption}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox
                                Text="{Binding OpenIdText, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource TextBox.Standard}"
                                FontFamily="Consolas"
                                MaxLength="12"
                                Width="200"
                                PreviewTextInput="OpenIdInput_PreviewTextInput"
                                DataObject.Pasting="OpenIdInput_Pasting" />
                            <ui:Button
                                Content="{localization:Localize LEAFV_Prog_Random}"
                                Icon="{ui:SymbolIcon ArrowShuffle24}"
                                Command="{Binding RandomOpenIdCommand}"
                                Appearance="Secondary"
                                Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding OpenIdPreview}"
                            FontFamily="Consolas"
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Visibility="{Binding OpenIdPreview, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Text="{Binding OpenIdError}"
                            Margin="0,4,0,0"
                            Foreground="{StaticResource Brush.Error}"
                            Visibility="{Binding OpenIdError, Converter={StaticResource NullToVisibility}}" />
                    </StackPanel>

                    <TextBlock Text="{localization:Localize Prog_BothHint}"
                        TextWrapping="Wrap"
                        FontSize="{StaticResource FontSize.Caption}"
                        Margin="0,16,0,0"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Visibility="{Binding ProgramBoth, Converter={StaticResource BoolToVisibility}}" />

                    <!-- ═══════════ GP key ═══════════ -->
                    <TextBlock Text="{localization:Localize Prog_GpKey}"
                        Style="{StaticResource Section.Header}"
                        Margin="0,20,0,8" />
                    <RadioButton
                        Content="{localization:Localize PKOC_Programming_DefaultKey}"
                        GroupName="GpKey"
                        IsChecked="True"
                        Margin="0,0,0,4" />
                    <RadioButton
                        Content="{localization:Localize PKOC_Programming_CustomKey}"
                        GroupName="GpKey"
                        IsChecked="{Binding UseCustomKey}"
                        Margin="0,0,0,4" />
                    <StackPanel
                        Margin="28,4,0,0"
                        Visibility="{Binding UseCustomKey, Converter={StaticResource BoolToVisibility}}">
                        <TextBox
                            Text="{Binding CustomKeyHex, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource TextBox.Standard}"
                            FontFamily="Consolas"
                            MaxLength="32"
                            CharacterCasing="Upper"
                            Width="300"
                            HorizontalAlignment="Left"
                            PreviewTextInput="CustomKeyInput_PreviewTextInput"
                            DataObject.Pasting="CustomKeyInput_Pasting" />
                        <TextBlock
                            Text="{Binding CustomKeyHex.Length, StringFormat='{}{0}/32 hex characters'}"
                            FontSize="{StaticResource FontSize.Caption}"
                            Margin="0,2,0,0"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════ Progress and results: outside the scroll area, always visible ═══════════ -->
        <ScrollViewer Grid.Row="2" MaxHeight="240" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,0,24,8">
                <ProgressBar
                    IsIndeterminate="True"
                    Height="4"
                    Margin="0,0,0,0"
                    Visibility="{Binding IsProgramming, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock
                    Text="{Binding ProgrammingStatus}"
                    Margin="0,8,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Visibility="{Binding ProgrammingStatus, Converter={StaticResource NullToVisibility}}" />

                <Border
                    Margin="0,8,0,0"
                    Padding="12,8"
                    CornerRadius="{StaticResource CornerRadius.Small}"
                    Background="{StaticResource Brush.Success}"
                    Visibility="{Binding ProgrammingResult, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="{Binding ProgrammingResult}" Foreground="White" FontWeight="Medium" TextWrapping="Wrap" />
                </Border>

                <Border
                    Margin="0,8,0,0"
                    Padding="12,8"
                    CornerRadius="{StaticResource CornerRadius.Small}"
                    Background="{StaticResource Brush.Warning}"
                    Visibility="{Binding ProgrammingWarning, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="{Binding ProgrammingWarning}" Foreground="White" TextWrapping="Wrap" />
                </Border>

                <Border
                    Margin="0,8,0,0"
                    Padding="12,8"
                    CornerRadius="{StaticResource CornerRadius.Small}"
                    Background="{StaticResource Brush.Error}"
                    Visibility="{Binding ProgrammingError, Converter={StaticResource NullToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding ProgrammingError}" Foreground="White" TextWrapping="Wrap" />
                        <ui:Button
                            Content="{localization:Localize PKOC_Programming_Dismiss}"
                            Command="{Binding DismissProgrammingErrorCommand}"
                            Margin="0,4,0,0"
                            Appearance="Secondary" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════ Buttons ═══════════ -->
        <Border Grid.Row="3"
            Padding="24,12"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button
                    Content="{localization:Localize Prog_Run}"
                    Icon="{ui:SymbolIcon ArrowDownload24}"
                    Command="{Binding ProgramCardCommand}"
                    Appearance="Primary"
                    MinWidth="120" />
                <ui:Button
                    Content="{localization:Localize Prog_Close}"
                    Click="Close_Click"
                    Appearance="Secondary"
                    MinWidth="100"
                    Margin="8,0,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
