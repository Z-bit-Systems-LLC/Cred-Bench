<UserControl
    x:Class="CredBench.Windows.Views.CardDetails.Iso14443DetailsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:CredBench.Core.Models.TechnologyDetails;assembly=Core"
    xmlns:localization="clr-namespace:ZBitSystems.Wpf.UI.Localization;assembly=ZBitSystems.Wpf.UI"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance models:ISO14443Details}">

    <StackPanel Margin="{StaticResource Padding.Card}">
        <!-- Card Info -->
        <Grid Margin="{StaticResource Margin.Section}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{StaticResource Gutter.Medium}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                Style="{StaticResource Field.Label}"
                Text="{localization:Localize ISO14443_Manufacturer}"
                TextAlignment="Right" />
            <TextBlock Grid.Row="0" Grid.Column="2"
                Style="{StaticResource Field.Value}"
                Text="{Binding Manufacturer, FallbackValue='Unknown'}" />

            <TextBlock Grid.Row="1" Grid.Column="0"
                Style="{StaticResource Field.Label}"
                Text="{localization:Localize ISO14443_UIDLength}"
                TextAlignment="Right" />
            <TextBlock Grid.Row="1" Grid.Column="2"
                Style="{StaticResource Field.Value}"
                Text="{Binding UIDLength, FallbackValue='N/A'}" />

            <TextBlock Grid.Row="2" Grid.Column="0"
                Style="{StaticResource Field.Label}"
                Text="{localization:Localize ISO14443_UID}"
                TextAlignment="Right" />
            <TextBlock Grid.Row="2" Grid.Column="2"
                Style="{StaticResource Field.Value}"
                Text="{Binding UIDBytes, FallbackValue='N/A'}"
                FontFamily="Consolas" />
        </Grid>

        <!-- CSN disclaimer -->
        <Border Padding="12,8"
            CornerRadius="{StaticResource CornerRadius.Small}"
            Background="{StaticResource Brush.Warning}"
            AutomationProperties.AutomationId="ISO14443_CSNDisclaimer">
            <DockPanel>
                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="Warning24" Foreground="White"
                    Margin="0,0,8,0" VerticalAlignment="Top" />
                <TextBlock Text="{localization:Localize ISO14443_CSNDisclaimer}"
                    Foreground="White" FontWeight="Medium" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
